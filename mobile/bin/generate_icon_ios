#!/bin/bash -e

# --------------------------------------------------------
# Generate app icons and xcassets file from a single image
# Derived from:
#  https://gist.github.com/benvium/2be6d673aa9ac284bb8a
# --------------------------------------------------------

# Check imagemagick is installed
# http://stackoverflow.com/questions/592620/check-if-a-program-exists-from-a-bash-script
command -v convert >/dev/null 2>&1 || { echo >&2 "Imagemagick is required but not installed"; exit 1; }

# Basic usage help text
test "$#" -eq 2 || { echo >&2 "Usage: $0 [appName] [outputDir]"; exit 1; }

# Ensure we're running in location of script.
cd $(dirname "$0")

appName="$1"
outputDir="$2"

test -d "../app_config/${appName}" || { echo >&2 "${appName} doesn't appear to be a valid app name"; exit 1; }

sourceIconName="../app_config/${appName}/icons/ios.png"

# Make sure the source image is valid
file "${sourceIconName}" | grep "PNG image data, 1024 x 1024" >/dev/null 2>&1 || { echo >&2 "A 1024x1024 PNG must be available at ${sourceIconName}"; exit 1; }

iconPath="${outputDir}/Images.xcassets/AppIcon.appiconset"

mkdir -p "${iconPath}"

# clean it out
rm -rf "${iconPath}"/*.png

# iOS 7-14
# iPhone-Notification
convert $sourceIconName -resize 40x40 -alpha off $iconPath/iPhone-Notification-20@2x.png
convert $sourceIconName -resize 60x60 -alpha off $iconPath/iPhone-Notification-20@3x.png

# iPhone
convert $sourceIconName -resize 58x58 -alpha off $iconPath/iPhone-29@2x.png
convert $sourceIconName -resize 87x87 -alpha off $iconPath/iPhone-29@3x.png

# iPhone Spotlight
convert $sourceIconName -resize  80x80  -alpha off $iconPath/iPhone-Spotlight-40@2x.png
convert $sourceIconName -resize 120x120 -alpha off $iconPath/iPhone-Spotlight-40@3x.png

# iPhone App
convert $sourceIconName -resize 120x120 -alpha off $iconPath/iPhone-App-60@2x.png
convert $sourceIconName -resize 180x180 -alpha off $iconPath/iPhone-App-60@3x.png

# iPad Notifications
convert $sourceIconName -resize 20x20 -alpha off $iconPath/iPad-Notification-20@1x.png
convert $sourceIconName -resize 40x40 -alpha off $iconPath/iPad-Notification-20@2x.png

# iPad Settings
convert $sourceIconName -resize 29x29 -alpha off $iconPath/iPad-Settings-29@1x.png
convert $sourceIconName -resize 58x58 -alpha off $iconPath/iPad-Settings-29@2x.png

# iPad Spotlight
convert $sourceIconName -resize 40x40 -alpha off $iconPath/iPad-Spotlight-40@1x.png
convert $sourceIconName -resize 80x80 -alpha off $iconPath/iPad-Spotlight-40@2x.png

# iPad App
convert $sourceIconName -resize  76x76  -alpha off $iconPath/iPad-Spotlight-76@1x.png
convert $sourceIconName -resize 152x152 -alpha off $iconPath/iPad-Spotlight-76@2x.png

# iPad Pro
convert $sourceIconName -resize 167x167 -alpha off $iconPath/iPad-Pro-83.5@2x.png

# App Store
convert $sourceIconName -resize 1024x1024 -alpha off $iconPath/App-Store-1024x1024.png

cat > "${iconPath}/Contents.json" << EOF
{
  "images" : [
    {
      "filename" : "iPhone-Notification-20@2x.png",
      "idiom" : "iphone",
      "scale" : "2x",
      "size" : "20x20"
    },
    {
      "filename" : "iPhone-Notification-20@3x.png",
      "idiom" : "iphone",
      "scale" : "3x",
      "size" : "20x20"
    },
    {
      "filename" : "iPhone-29@2x.png",
      "idiom" : "iphone",
      "scale" : "2x",
      "size" : "29x29"
    },
    {
      "filename" : "iPhone-29@3x.png",
      "idiom" : "iphone",
      "scale" : "3x",
      "size" : "29x29"
    },
    {
      "filename" : "iPhone-Spotlight-40@2x.png",
      "idiom" : "iphone",
      "scale" : "2x",
      "size" : "40x40"
    },
    {
      "filename" : "iPhone-Spotlight-40@3x.png",
      "idiom" : "iphone",
      "scale" : "3x",
      "size" : "40x40"
    },
    {
      "filename" : "iPhone-App-60@2x.png",
      "idiom" : "iphone",
      "scale" : "2x",
      "size" : "60x60"
    },
    {
      "filename" : "iPhone-App-60@3x.png",
      "idiom" : "iphone",
      "scale" : "3x",
      "size" : "60x60"
    },
    {
      "filename" : "iPad-Notification-20@1x.png",
      "idiom" : "ipad",
      "scale" : "1x",
      "size" : "20x20"
    },
    {
      "filename" : "iPad-Notification-20@2x.png",
      "idiom" : "ipad",
      "scale" : "2x",
      "size" : "20x20"
    },
    {
      "filename" : "iPad-Settings-29@1x.png",
      "idiom" : "ipad",
      "scale" : "1x",
      "size" : "29x29"
    },
    {
      "filename" : "iPad-Settings-29@2x.png",
      "idiom" : "ipad",
      "scale" : "2x",
      "size" : "29x29"
    },
    {
      "filename" : "iPad-Spotlight-40@1x.png",
      "idiom" : "ipad",
      "scale" : "1x",
      "size" : "40x40"
    },
    {
      "filename" : "iPad-Spotlight-40@2x.png",
      "idiom" : "ipad",
      "scale" : "2x",
      "size" : "40x40"
    },
    {
      "filename" : "iPad-Spotlight-76@1x.png",
      "idiom" : "ipad",
      "scale" : "1x",
      "size" : "76x76"
    },
    {
      "filename" : "iPad-Spotlight-76@2x.png",
      "idiom" : "ipad",
      "scale" : "2x",
      "size" : "76x76"
    },
    {
      "filename" : "iPad-Pro-83.5@2x.png",
      "idiom" : "ipad",
      "scale" : "2x",
      "size" : "83.5x83.5"
    },
    {
      "filename" : "App-Store-1024x1024.png",
      "idiom" : "ios-marketing",
      "scale" : "1x",
      "size" : "1024x1024"
    }
  ],
  "info" : {
    "author" : "xcode",
    "version" : 1
  }
}
EOF

cat > "${iconPath}/../Contents.json" << EOF
{
  "info": {
    "version": 1,
    "author": "xcode"
  }
}
EOF