-# This is a basic workflow to help you get started with Actions
-name: CI
+# This is a basic CI workflow to help you get started with Actions
+name: DEV-API-CI
 
-# Triggers the workflow in a few conditions
-# 1. Every change to main (a merged PR will result in a push)
+# Triggers the workflow on changes to `dev-api/**`
+# 1. On main branch (a merged PR will result in a push)
 # 2. When a pull request created / updated
 # 3. Manually
 on:
   push:
     branches: [main]
+    paths: ["dev-api/**", "graph/**"]
   pull_request:
     types: [opened, reopened, synchronize]
+    paths: ["dev-api/**", "graph/**"]
   workflow_dispatch:
 
+defaults:
+  run:
+    # Default to commands running in the dev-api folder
+    working-directory: ./dev-api
+
 # A workflow run is made up of one or more jobs that can run sequentially or in parallel
 jobs:
   # Installs dependencies
@@ -25,40 +32,28 @@ jobs:
       JWT_ENCRYPT_KEY: encrypt
       REVIEWS_ENABLED: true
       REVIEW_PROBABILITY: 1
+      SCHEMA_PATH: "../graph/schema/**/*.graphql"
 
     # Steps represent a sequence of tasks that will be executed as part of the job
     steps:
       # Checks-out your repository under $GITHUB_WORKSPACE, so your job can access it
       - uses: actions/checkout@v2
+      
       - uses: actions/setup-node@v2
         with:
           node-version: "~12"
-
-      # The next few steps manage installing + caching dependencies via Yarn
-      - name: Get yarn cache directory path
-        id: yarn-cache-dir-path
-        run: echo "::set-output name=dir::$(yarn cache dir)"
-
-      - name: Setup cache
-        uses: actions/cache@v2
-        id: yarn-cache
-        with:
-          path: ${{ steps.yarn-cache-dir-path.outputs.dir }}
-          key: ${{ runner.os }}-yarn-${{ hashFiles('**/yarn*') }}
-          restore-keys: |
-            ${{ runner.os }}-yarn-
-
-      - name: Install yarn dependencies without cache
-        if: steps.yarn-cache.outputs.cache-hit != 'true'
-        run: yarn --frozen-lockfile
+          cache: "yarn"
+          cache-dependency-path: "dev-api/yarn.lock"
 
       - name: Install yarn dependencies from cache
-        if: steps.yarn-cache.outputs.cache-hit == 'true'
         run: yarn --frozen-lockfile --prefer-offline
 
       # And then we move on to the meat of the action
+      - name: Build Graph
+        run: yarn build-graph
+
       - name: Build Typescript
-        run: yarn build-graph build-ts
+        run: yarn build-ts
 
       - name: Run ESLint
         run: yarn lint
