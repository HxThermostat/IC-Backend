diff --git a/intellicomfort-api/Dockerfile b/intellicomfort-api/Dockerfile
index 2f143f99f..c424f6b2c 100644
--- a/intellicomfort-api/Dockerfile
+++ b/intellicomfort-api/Dockerfile
@@ -1,13 +1,15 @@
 FROM node:12-alpine3.12 AS build
 
-WORKDIR /usr/src/api
+# NB we expect the repo root to be the build context
 
-COPY ./package.json ./yarn.lock ./
+WORKDIR /usr/src/intellicomfort-api
+
+COPY intellicomfort-api/package.json intellicomfort-api/yarn.lock ./
 
 RUN yarn install --frozen-lockfile
 
-COPY ./tsconfig.json ./
-COPY ./src ./src
+COPY intellicomfort-api/tsconfig.json ./
+COPY intellicomfort-api/src ./src
 
 RUN yarn build-ts
 
@@ -16,22 +18,22 @@ ENV NODE_ENV=production
 
 RUN apk --no-cache add curl
 
-WORKDIR /usr/src/api
+WORKDIR /usr/src/intellicomfort-api
 
 RUN chown node:node .
 
-COPY ./entrypoint ./entrypoint
+COPY intellicomfort-api/entrypoint ./entrypoint
 RUN chown node:node ./entrypoint
 RUN chmod u+x ./entrypoint
 
 USER node
 
-COPY ./package.json ./yarn.lock ./
+COPY intellicomfort-api/package.json intellicomfort-api/yarn.lock ./
 
 RUN yarn install --frozen-lockfile
 
-COPY ./schema ./schema
-COPY --from=build /usr/src/api/dist ./dist
+COPY ./graph ../graph
+COPY --from=build /usr/src/intellicomfort-api/dist ./dist
 
 EXPOSE 3000
 
