From 04789e78706bf27b9d63ffc90b2d2ffd090cddeb Mon Sep 17 00:00:00 2001
From: Jacob Gable <jacob.gable@gmail.com>
Date: Mon, 9 Aug 2021 14:27:30 -0700
Subject: [PATCH] Update schema paths after moving to /graph

- Add SCHEMA_PATH to dev-api/config
- Update schema/index to use SCHEMA_PATH env variable
- Update codegen.yml to use SCHEMA_PATH env variable
---
 dev-api/codegen.yml                    |  4 ++--
 dev-api/package.json                   |  4 ++--
 dev-api/src/config.ts                  |  6 ++++++
 dev-api/src/schema/index.ts            |  3 ++-
 intellicomfort-api/Dockerfile          | 20 +++++++++++---------
 intellicomfort-api/codegen.yml         |  2 +-
 intellicomfort-api/package.json        |  4 ++--
 intellicomfort-api/src/config.ts       |  6 ++++++
 intellicomfort-api/src/schema/index.ts |  4 +++-
 mobile/codegen.yml                     |  2 +-
 10 files changed, 36 insertions(+), 19 deletions(-)

diff --git a/dev-api/codegen.yml b/dev-api/codegen.yml
index 834bdf1a1..b6ed81983 100644
--- a/dev-api/codegen.yml
+++ b/dev-api/codegen.yml
@@ -1,6 +1,6 @@
 overwrite: true
-schema: "schema/**/*.graphql"
-documents: null
+schema: ${SCHEMA_PATH:../graph/schema/**/*.graphql}
+documents: []
 generates:
   ./src/schema/resolvers-types.ts:
     plugins:
diff --git a/dev-api/package.json b/dev-api/package.json
index b32b7b2d7..b50a475ca 100644
--- a/dev-api/package.json
+++ b/dev-api/package.json
@@ -10,9 +10,9 @@
     "start": "node -r dotenv/config dist/index.js",
     "build": "yarn build-graph && yarn build-ts",
     "build-ts": "tsc",
-    "build-graph": "graphql-codegen --config codegen.yml",
+    "build-graph": "graphql-codegen --config codegen.yml -r dotenv/config",
     "watch-ts": "tsc -w",
-    "watch-graph": "graphql-codegen --watch --config codegen.yml",
+    "watch-graph": "graphql-codegen --watch --config codegen.yml -r dotenv/config",
     "watch-node": "nodemon -r dotenv/config dist/index.js",
     "clean": "rm -Rf dist/*",
     "lint": "eslint .",
diff --git a/dev-api/src/config.ts b/dev-api/src/config.ts
index bdc3faff8..986d7b3e2 100644
--- a/dev-api/src/config.ts
+++ b/dev-api/src/config.ts
@@ -40,3 +40,9 @@ export const KLIMATE_FORCE_FIXTURES_SYNC = env
   .default(0)
   .required(false)
   .asBool();
+
+export const SCHEMA_PATH: string = env
+  .get("SCHEMA_PATH")
+  .default("../graph/schema/**/*.graphql")
+  .required()
+  .asString();
diff --git a/dev-api/src/schema/index.ts b/dev-api/src/schema/index.ts
index f6a483669..47fb176eb 100644
--- a/dev-api/src/schema/index.ts
+++ b/dev-api/src/schema/index.ts
@@ -1,12 +1,13 @@
